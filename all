      "// ===== Task 7: Sensor Events using Lambdas =====",
      "#include <iostream>",
      "#include <vector>",
      "#include <string>",
      "#include <functional>",
      "",
      "// SensorEvent class",
      "class SensorEvent {",
      "private:",
      "    int eventId;",
      "    std::string type;",
      "    double value;",
      "",
      "public:",
      "    SensorEvent(int id, std::string type, double value)",
      "        : eventId(id), type(std::move(type)), value(value) {}",
      "",
      "    int getId() const { return eventId; }",
      "    std::string getType() const { return type; }",
      "    double getValue() const { return value; }",
      "",
      "    void setValue(double newValue) { value = newValue; }",
      "",
      "    void display() const {",
      "        std::cout << \"Event[ID=\" << eventId",
      "                  << \", Type=\" << type",
      "                  << \", Value=\" << value << \"]\\n\";",
      "    }",
      "};",
      "",
      "// EventProcessor class",
      "class EventProcessor {",
      "private:",
      "    std::vector<SensorEvent> events;",
      "",
      "public:",
      "    void addEvent(const SensorEvent& event) {",
      "        events.push_back(event);",
      "    }",
      "",
      "    void processEvents(",
      "        const std::function<bool(const SensorEvent&)>& filter,",
      "        const std::function<void(SensorEvent&)>& action",
      "    ) {",
      "        for (auto& event : events) {",
      "            if (filter(event)) {",
      "                action(event);",
      "            }",
      "        }",
      "    }",
      "",
      "    void displayAll() const {",
      "        for (const auto& event : events) {",
      "            event.display();",
      "        }",
      "    }",
      "",
      "    const std::vector<SensorEvent>& getEvents() const {",
      "        return events;",
      "    }",
      "};",
      "",
      "// Free function",
      "void printFilteredEvents(",
      "    const std::vector<SensorEvent>& events,",
      "    const std::function<bool(const SensorEvent&)>& filter",
      ") {",
      "    for (const auto& event : events) {",
      "        if (filter(event)) {",
      "            event.display();",
      "        }",
      "    }",
      "}",
      "",
      "// main",
      "int main() {",
      "    EventProcessor processor;",
      "",
      "    processor.addEvent({1, \"Temperature\", 85.0});",
      "    processor.addEvent({2, \"Pressure\", 101.3});",
      "    processor.addEvent({3, \"Speed\", 60.0});",
      "    processor.addEvent({4, \"Temperature\", 90.0});",
      "    processor.addEvent({5, \"Pressure\", 99.5});",
      "",
      "    processor.displayAll();",
      "",
      "    auto isTemperature = [](const SensorEvent& e) {",
      "        return e.getType() == \"Temperature\";",
      "    };",
      "",
      "    printFilteredEvents(processor.getEvents(), isTemperature);",
      "",
      "    processor.processEvents(",
      "        [](const SensorEvent& e) { return e.getType() == \"Pressure\"; },",
      "        [](SensorEvent& e) { e.setValue(e.getValue() * 1.10); }",
      "    );",
      "",
      "    processor.displayAll();",
      "",
      "    return 0;",
      "}"
    ],
    "description": "Task 7 - Lambda expressions for filtering and modifying sensor events"
