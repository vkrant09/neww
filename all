  "Task1 Sensor Cluster": {
    "prefix": "task1_sensorcluster",
    "body": [
      "#include <iostream>",
      "#include <vector>",
      "#include <string>",
      "",
      "// ----------------------------",
      "// enum class for sensor status",
      "// ----------------------------",
      "enum class SensorStatus {",
      "    Active,",
      "    Inactive,",
      "    Faulty",
      "};",
      "",
      "const char* toString(SensorStatus status) {",
      "    switch (status) {",
      "        case SensorStatus::Active:   return \"Active\";",
      "        case SensorStatus::Inactive: return \"Inactive\";",
      "        case SensorStatus::Faulty:   return \"Faulty\";",
      "    }",
      "    return \"Unknown\";",
      "}",
      "",
      "// ----------------------------",
      "// Sensor class",
      "// ----------------------------",
      "class Sensor {",
      "private:",
      "    int id;",
      "    SensorStatus status;",
      "",
      "public:",
      "    Sensor(int id, SensorStatus status)",
      "        : id(id), status(status) {}",
      "",
      "    Sensor(const Sensor&) = default;",
      "    Sensor(Sensor&&) = delete;",
      "    Sensor& operator=(const Sensor&) = delete;",
      "    ~Sensor() = default;",
      "",
      "    int getId() const { return id; }",
      "",
      "    SensorStatus getStatus() const { return status; }",
      "",
      "    void setStatus(SensorStatus newStatus) {",
      "        status = newStatus;",
      "    }",
      "};",
      "",
      "// ----------------------------",
      "// SensorCluster (final)",
      "// ----------------------------",
      "class SensorCluster final {",
      "private:",
      "    std::string clusterName;",
      "    std::vector<Sensor*> sensors;",
      "",
      "public:",
      "    explicit SensorCluster(std::string name)",
      "        : clusterName(std::move(name)) {}",
      "",
      "    SensorCluster(const SensorCluster&) = delete;",
      "    SensorCluster& operator=(const SensorCluster&) = delete;",
      "    ~SensorCluster() = default;",
      "",
      "    void addSensor(Sensor* sensor) {",
      "        if (sensor != nullptr) {",
      "            sensors.push_back(sensor);",
      "        }",
      "    }",
      "",
      "    void displayClusterInfo() const {",
      "        std::cout << \"Cluster: \" << clusterName",
      "                  << \", Sensors: \" << sensors.size()",
      "                  << '\\n';",
      "    }",
      "};",
      "",
      "// ----------------------------",
      "// Free function",
      "// ----------------------------",
      "void printSensorInfo(const Sensor& sensor) {",
      "    std::cout << \"Sensor[ID=\" << sensor.getId()",
      "              << \", Status=\" << toString(sensor.getStatus())",
      "              << \"]\\n\";",
      "}",
      "",
      "// ----------------------------",
      "// main",
      "// ----------------------------",
      "int main() {",
      "    Sensor s1(101, SensorStatus::Active);",
      "    Sensor s2(102, SensorStatus::Inactive);",
      "    Sensor s3(103, SensorStatus::Faulty);",
      "",
      "    SensorCluster cluster(\"EngineBay\");",
      "",
      "    cluster.addSensor(&s1);",
      "    cluster.addSensor(&s2);",
      "    cluster.addSensor(&s3);",
      "    cluster.addSensor(nullptr);",
      "",
      "    cluster.displayClusterInfo();",
      "",
      "    printSensorInfo(s1);",
      "    printSensorInfo(s2);",
      "    printSensorInfo(s3);",
      "",
      "    return 0;",
      "}"
    ],
    "description": "Task 1: Sensor & SensorCluster implementation using modern C++"
  },



  "Task2 Using Alias Diagnostics": {
    "prefix": ["Task2_UsingAlias", "task2_using"],
    "body": [
      "// ===== Task 2: Diagnostics using `using` keyword =====",
      "#include <iostream>",
      "#include <vector>",
      "",
      "// enum class for severity levels",
      "enum class Severity {",
      "    Low,",
      "    Medium,",
      "    High,",
      "    Critical",
      "};",
      "",
      "// global type alias",
      "using CodeType = int;",
      "",
      "// DiagnosticRecord class",
      "class DiagnosticRecord {",
      "private:",
      "    CodeType code;",
      "    Severity severity;",
      "",
      "public:",
      "    DiagnosticRecord(CodeType code, Severity severity)",
      "        : code(code), severity(severity) {}",
      "",
      "    DiagnosticRecord(const DiagnosticRecord&) = default;",
      "    DiagnosticRecord(DiagnosticRecord&&) = default;",
      "    ~DiagnosticRecord() = default;",
      "",
      "    CodeType getCode() const { return code; }",
      "    Severity getSeverity() const { return severity; }",
      "",
      "    void display() const {",
      "        std::cout << \"Code: \" << code",
      "                  << \", Severity: \" << static_cast<int>(severity)",
      "                  << '\\n';",
      "    }",
      "};",
      "",
      "// DiagnosticManager class",
      "class DiagnosticManager {",
      "public:",
      "    using RecordList = std::vector<DiagnosticRecord>;",
      "    using RecordPtr  = DiagnosticRecord*;",
      "",
      "private:",
      "    RecordList records;",
      "",
      "public:",
      "    DiagnosticManager() = default;",
      "    ~DiagnosticManager() = default;",
      "",
      "    void addRecord(const DiagnosticRecord& record) {",
      "        records.push_back(record);",
      "    }",
      "",
      "    void displayAll() const {",
      "        for (const auto& record : records) {",
      "            record.display();",
      "        }",
      "    }",
      "",
      "    RecordPtr findRecordByCode(CodeType code) {",
      "        for (auto& record : records) {",
      "            if (record.getCode() == code) {",
      "                return &record;",
      "            }",
      "        }",
      "        return nullptr;",
      "    }",
      "};",
      "",
      "// Free function",
      "void printRecordInfo(const DiagnosticRecord& record) {",
      "    record.display();",
      "}",
      "",
      "// main",
      "int main() {",
      "    DiagnosticRecord r1(101, Severity::Low);",
      "    DiagnosticRecord r2(102, Severity::High);",
      "    DiagnosticRecord r3(103, Severity::Critical);",
      "",
      "    DiagnosticManager manager;",
      "    manager.addRecord(r1);",
      "    manager.addRecord(r2);",
      "    manager.addRecord(r3);",
      "",
      "    manager.displayAll();",
      "",
      "    if (auto* rec = manager.findRecordByCode(102)) {",
      "        printRecordInfo(*rec);",
      "    }",
      "",
      "    return 0;",
      "}"
    ],
    "description": "Task 2 - Diagnostics module using `using` keyword (global + class scope)"
  },



  "Task3 Polymorphism Controllers": {
    "prefix": ["Task3_Polymorphism", "task3_poly"],
    "body": [
      "// ===== Task 3: Controllers & Polymorphism =====",
      "#include <iostream>",
      "#include <string>",
      "",
      "// Abstract Base Class",
      "class Controller {",
      "protected:",
      "    std::string name;",
      "",
      "public:",
      "    explicit Controller(std::string name)",
      "        : name(std::move(name)) {}",
      "",
      "    virtual ~Controller() = default;",
      "",
      "    virtual void executeCommand() const = 0;",
      "",
      "    virtual void displayStatus() const {",
      "        std::cout << \"Controller: \" << name << '\\n';",
      "    }",
      "};",
      "",
      "// SteeringController (final)",
      "class SteeringController final : public Controller {",
      "private:",
      "    int angle;",
      "",
      "public:",
      "    SteeringController(std::string name, int angle)",
      "        : Controller(std::move(name)), angle(angle) {}",
      "",
      "    ~SteeringController() override = default;",
      "",
      "    void executeCommand() const override {",
      "        std::cout << \"Executing Steering Command: Angle = \"",
      "                  << angle << '\\n';",
      "    }",
      "",
      "    void displayStatus() const override {",
      "        std::cout << \"Steering Controller: \" << name",
      "                  << \", Angle = \" << angle << '\\n';",
      "    }",
      "};",
      "",
      "// BrakeController (final)",
      "class BrakeController final : public Controller {",
      "private:",
      "    int pressure;",
      "",
      "public:",
      "    BrakeController(std::string name, int pressure)",
      "        : Controller(std::move(name)), pressure(pressure) {}",
      "",
      "    ~BrakeController() override = default;",
      "",
      "    void executeCommand() const override {",
      "        std::cout << \"Executing Brake Command: Pressure = \"",
      "                  << pressure << '\\n';",
      "    }",
      "",
      "    void displayStatus() const override {",
      "        std::cout << \"Brake Controller: \" << name",
      "                  << \", Pressure = \" << pressure << '\\n';",
      "    }",
      "};",
      "",
      "// ControlSystem",
      "class ControlSystem {",
      "private:",
      "    Controller* activeController;",
      "",
      "public:",
      "    ControlSystem() : activeController(nullptr) {}",
      "",
      "    void setActiveController(Controller* controller) {",
      "        activeController = controller;",
      "    }",
      "",
      "    void runActiveController() const {",
      "        if (activeController) {",
      "            activeController->executeCommand();",
      "        } else {",
      "            std::cout << \"No active controller set\\n\";",
      "        }",
      "    }",
      "};",
      "",
      "// Free function",
      "void printControllerInfo(const Controller* controller) {",
      "    if (controller) {",
      "        controller->displayStatus();",
      "    }",
      "}",
      "",
      "// main",
      "int main() {",
      "    SteeringController steering(\"Steering\", 30);",
      "    BrakeController brake(\"Brake\", 80);",
      "",
      "    ControlSystem system;",
      "",
      "    system.setActiveController(&steering);",
      "    system.runActiveController();",
      "",
      "    system.setActiveController(&brake);",
      "    system.runActiveController();",
      "",
      "    system.setActiveController(nullptr);",
      "    system.runActiveController();",
      "",
      "    printControllerInfo(&steering);",
      "    printControllerInfo(&brake);",
      "",
      "    return 0;",
      "}"
    ],
    "description": "Task 3 - Polymorphism using abstract base class, override, final, nullptr"
  },


