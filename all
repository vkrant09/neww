  "Task5 Move Semantics DataLog": {
    "prefix": ["Task5_MoveSemantics", "task5_move"],
    "body": [
      "// ===== Task 5: Move Semantics =====",
      "#include <iostream>",
      "#include <vector>",
      "",
      "// DataLog class demonstrating move semantics",
      "class DataLog {",
      "private:",
      "    int logId;",
      "    std::vector<int> rawData;",
      "",
      "public:",
      "    // Constructor",
      "    DataLog(int id, std::vector<int> data)",
      "        : logId(id), rawData(std::move(data)) {}",
      "",
      "    // Copy constructor allowed",
      "    DataLog(const DataLog&) = default;",
      "",
      "    // Move constructor",
      "    DataLog(DataLog&& other) noexcept",
      "        : logId(other.logId), rawData(std::move(other.rawData)) {}",
      "",
      "    // Copy assignment deleted",
      "    DataLog& operator=(const DataLog&) = delete;",
      "",
      "    // Move assignment",
      "    DataLog& operator=(DataLog&& other) noexcept {",
      "        if (this != &other) {",
      "            logId = other.logId;",
      "            rawData = std::move(other.rawData);",
      "        }",
      "        return *this;",
      "    }",
      "",
      "    ~DataLog() = default;",
      "",
      "    int getId() const { return logId; }",
      "    size_t getDataSize() const { return rawData.size(); }",
      "",
      "    void display() const {",
      "        std::cout << \"Log ID: \" << logId",
      "                  << \", Data Size: \" << rawData.size()",
      "                  << '\\n';",
      "    }",
      "};",
      "",
      "// Logger class",
      "class Logger {",
      "private:",
      "    std::vector<DataLog> logs;",
      "",
      "public:",
      "    Logger() = default;",
      "    ~Logger() = default;",
      "",
      "    // Accept by value to enable move",
      "    void addLog(DataLog log) {",
      "        logs.push_back(std::move(log));",
      "    }",
      "",
      "    void displayAll() const {",
      "        for (const auto& log : logs) {",
      "            log.display();",
      "        }",
      "    }",
      "};",
      "",
      "// Free function",
      "void printLogInfo(const DataLog& log) {",
      "    log.display();",
      "}",
      "",
      "// main",
      "int main() {",
      "    std::vector<int> data(1000, 42);",
      "    DataLog log1(101, std::move(data));",
      "",
      "    Logger logger;",
      "    logger.addLog(std::move(log1));",
      "",
      "    logger.displayAll();",
      "",
      "    std::cout << \"Original Log Data Size: \"",
      "              << log1.getDataSize() << '\\n';",
      "",
      "    std::vector<int> data2(1000, 7);",
      "    DataLog log2(102, std::move(data2));",
      "    logger.addLog(std::move(log2));",
      "",
      "    logger.displayAll();",
      "",
      "    return 0;",
      "}"
    ],
    "description": "Task 5 - Move semantics using move constructor and move assignment"
  },

