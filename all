      "",
      "    DisplayMinMaxPermitTax(vehicles);",
      "",
      "    std::cout << \"Total Tourist Permit Cost: \"",
      "              << TotalTouristPermitCost(vehicles) << '\\n';",
      "",
      "    return 0;",
      "}"
