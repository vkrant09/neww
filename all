      "#include <functional>",
      "",
      "// Fixed-size container of integers",
      "using IntContainer = std::array<int, 5>;",
      "",
      "// Function wrapper type",
      "using OperationFn = std::function<void(const IntContainer&)>;",
      "",
      "// 1. Print odd numbers",
      "void PrintOddNumbers(const IntContainer& data);",
      "",
      "// 2. Count elements divisible by 4",
      "void CountDivisibleByFour(const IntContainer& data);",
      "",
      "// 5. Apply all operations",
      "void Operation(",
      "    const std::vector<OperationFn>& operations,",
      "    const IntContainer& data",
      ");",
      "",
      "#endif // FUNCTIONALITIES_H",
      "",
      "",
      "// ====================================================",
      "// FILE: Functionalities.cpp",
      "// ====================================================",
      "#include \"Functionalities.h\"",
      "#include <iostream>",
      "#include <algorithm>",
      "#include <stdexcept>",
      "",
      "// Print all odd numbers",
      "void PrintOddNumbers(const IntContainer& data) {",
      "    std::cout << \"Odd numbers: \";",
      "    for (int value : data) {",
      "        if (value % 2 != 0) {",
      "            std::cout << value << \" \";",
      "        }",
      "    }",
      "    std::cout << '\\n';",
      "}",
      "",
      "// Count numbers divisible by 4",
      "void CountDivisibleByFour(const IntContainer& data) {",
      "    int count = std::count_if(",
      "        data.begin(), data.end(),",
      "        [](int value) { return value % 4 == 0; }",
      "    );",
      "    std::cout << \"Count divisible by 4: \" << count << '\\n';",
      "}",
      "",
      "// Apply all operations",
      "void Operation(",
      "    const std::vector<OperationFn>& operations,",
      "    const IntContainer& data",
      ") {",
      "    if (operations.empty()) {",
      "        throw std::runtime_error(\"No operations provided\");",
      "    }",
      "",
      "    for (const auto& fn : operations) {",
      "        fn(data);",
      "    }",
      "}",
      "",
      "",
      "// ====================================================",
      "// FILE: main.cpp",
      "// ====================================================",
      "#include <iostream>",
      "#include <algorithm>",
      "#include <stdexcept>",
      "",
      "int main() {",
      "",
      "    // Fixed-size container",
      "    IntContainer numbers{12, 7, 9, 20, 4};",
      "",
      "    // Dynamic container of functions",
      "    std::vector<OperationFn> operations;",
      "",
      "    // Function 1",
      "    operations.push_back(PrintOddNumbers);",
      "",
      "    // Function 2",
      "    operations.push_back(CountDivisibleByFour);",
