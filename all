      "",
      "// constexpr function",
      "constexpr int square(int x) {",
      "    return x * x;",
      "}",
      "",
      "// constexpr class",
      "class SensorConfig {",
      "private:",
      "    int threshold;",
      "",
      "public:",
      "    constexpr SensorConfig(int t) : threshold(t) {}",
      "",
      "    constexpr int getThreshold() const {",
      "        return threshold;",
      "    }",
      "};",
      "",
      "// Template with if constexpr",
      "template <typename T>",
      "constexpr bool isValidValue(T value) {",
      "    if constexpr (std::is_integral_v<T>) {",
      "        return value >= 0;",
      "    } else if constexpr (std::is_floating_point_v<T>) {",
      "        return value >= 0.0;",
      "    } else {",
      "        return false;",
      "    }",
      "}",
      "",
      "// main",
      "int main() {",
      "    constexpr int sq = square(5);",
      "    static_assert(sq == 25, \"Square failed\");",
      "",
      "    constexpr SensorConfig config(100);",
      "    static_assert(config.getThreshold() == 100, \"Invalid threshold\");",
      "",
      "    int runtimeValue = 10;",
      "    double runtimeValue2 = -3.5;",
      "",
      "    std::cout << \"Square(5): \" << sq << '\\n';",
      "    std::cout << \"Threshold: \" << config.getThreshold() << '\\n';",
      "",
      "    std::cout << \"Is 10 valid? \"",
      "              << isValidValue(runtimeValue) << '\\n';",
      "",
      "    std::cout << \"Is -3.5 valid? \"",
      "              << isValidValue(runtimeValue2) << '\\n';",
      "",
      "    return 0;",
      "}"
    ],
    "description": "Task 19 - Compile-time computation using constexpr and if constexpr"
