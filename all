      "                  << \", Value=\" << value << \"]\\n\";",
      "    }",
      "};",
      "",
      "// SensorPipeline class",
      "class SensorPipeline {",
      "private:",
      "    std::vector<Sensor> sensors;",
      "",
      "public:",
      "    void addSensor(const Sensor& sensor) {",
      "        sensors.push_back(sensor);",
      "    }",
      "",
      "    double computeAdjustedValue(double rawValue) const {",
      "        return rawValue + 2.5;",
      "    }",
      "",
      "    std::vector<Sensor>& getSensors() {",
      "        return sensors;",
      "    }",
      "",
      "    void displayAll() const {",
      "        for (const auto& s : sensors) {",
      "            s.display();",
      "        }",
      "    }",
      "};",
      "",
      "// Stage 1: read sensor async",
      "std::future<double> readSensorAsync(const Sensor& sensor) {",
      "    return std::async(std::launch::async, [&sensor]() {",
      "        return sensor.getValue();",
      "    });",
      "}",
      "",
      "// Stage 2: process sensor async",
      "std::future<double> processSensorAsync(",
      "    SensorPipeline& pipeline,",
      "    std::future<double> rawFuture",
      ") {",
      "    return std::async(std::launch::async,",
      "        [&pipeline, f = std::move(rawFuture)]() mutable {",
      "            double rawValue = f.get();",
      "            return pipeline.computeAdjustedValue(rawValue);",
      "        }",
      "    );",
      "}",
