      "",
      "// Sensor class",
      "class Sensor {",
      "private:",
      "    int id;",
      "    std::string type;",
      "    double value;",
      "",
      "public:",
      "    Sensor(int id, std::string type, double value)",
      "        : id(id), type(std::move(type)), value(value) {}",
      "",
      "    int getId() const { return id; }",
      "    const std::string& getType() const { return type; }",
      "    double getValue() const { return value; }",
      "",
      "    void setValue(double newValue) { value = newValue; }",
      "",
      "    void display() const {",
      "        std::cout << \"Sensor[ID=\" << id",
      "                  << \", Type=\" << type",
      "                  << \", Value=\" << value << \"]\\n\";",
      "    }",
      "};",
      "",
      "// main",
      "int main() {",
      "    std::vector<Sensor> sensors{",
      "        {1, \"Temperature\", 85.0},",
      "        {2, \"Pressure\", 101.3},",
      "        {3, \"Speed\", 60.0},",
      "        {4, \"Temperature\", 95.0},",
      "        {5, \"Pressure\", 110.0}",
      "    };",
