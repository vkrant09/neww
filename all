      "#include <string>",
      "#include <future>",
      "",
      "// Sensor class",
      "class Sensor {",
      "private:",
      "    int id;",
      "    std::string type;",
      "    double value;",
      "",
      "public:",
      "    Sensor(int id, std::string type, double value)",
