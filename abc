      "from functools import reduce",
      "",
      "# ---------------------------------",
      "# 1. square_even_numbers",
      "# ---------------------------------",
      "def square_even_numbers(nums):",
      "    \"\"\"",
      "    Returns list of squares of even numbers.",
      "    \"\"\"",
      "    return list(map(lambda x: x * x, filter(lambda x: x % 2 == 0, nums)))",
      "",
      "# ---------------------------------",
      "# 2. sum_values",
      "# ---------------------------------",
      "def sum_values(d):",
      "    \"\"\"",
      "    Returns sum of all values in dictionary.",
      "    \"\"\"",
      "    return reduce(lambda a, b: a + b, d.values(), 0)",
      "",
      "# ---------------------------------",
      "# 3. filter_dict_by_value",
      "# ---------------------------------",
      "def filter_dict_by_value(d, threshold):",
      "    \"\"\"",
      "    Keeps items where value >= threshold.",
      "    \"\"\"",
      "    return dict(filter(lambda item: item[1] >= threshold, d.items()))",
      "",
      "# ---------------------------------",
      "# 4. uppercase_strings",
      "# ---------------------------------",
      "def uppercase_strings(strings):",
      "    \"\"\"",
      "    Converts all strings to uppercase.",
      "    \"\"\"",
      "    return list(map(lambda s: s.upper(), strings))",
      "",
      "# ---------------------------------",
      "# 5. multiply_all",
      "# ---------------------------------",
      "def multiply_all(nums):",
      "    \"\"\"",
      "    Returns product of all numbers.",
      "    Empty list → 1",
      "    \"\"\"",
      "    return reduce(lambda a, b: a * b, nums, 1)",
      "",
      "# ---------------------------------",
      "# 6. invert_and_sum",
      "# ---------------------------------",
      "def invert_and_sum(d):",
      "    \"\"\"",
      "    Inverts dictionary and sums values for same keys.",
      "    Example: {'a':1,'b':1,'c':2} → {1:2, 2:1}",
      "    \"\"\"",
      "    result = {}",
      "",
      "    for value in d.values():",
      "        result[value] = result.get(value, 0) + 1",
      "",
      "    return result",
      "",
