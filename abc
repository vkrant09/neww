      "from abc import ABC, abstractmethod",
      "import math",
      "",
      "# ---------------------------------",
      "# 1. Abstract Base Class: Shape",
      "# ---------------------------------",
      "class Shape(ABC):",
      "    \"\"\"",
      "    Abstract base class.",
      "    Every shape MUST implement area().",
      "    \"\"\"",
      "",
      "    @abstractmethod",
      "    def area(self) -> float:",
      "        pass",
      "",
      "",
      "# ---------------------------------",
      "# 2. Circle Class",
      "# ---------------------------------",
      "class Circle(Shape):",
      "    def __init__(self, radius: float):",
      "        self.radius = radius",
      "",
      "    def area(self) -> float:",
      "        return math.pi * self.radius * self.radius",
      "",
      "",
      "# ---------------------------------",
      "# 3. Rectangle Class",
      "# ---------------------------------",
      "class Rectangle(Shape):",
      "    def __init__(self, width: float, height: float):",
      "        self.width = width",
      "        self.height = height",
      "",
      "    def area(self) -> float:",
      "        return self.width * self.height",
      "",
      "",
      "# ---------------------------------",
      "# 4. calc_areas",
      "# ---------------------------------",
      "def calc_areas(shapes):",
      "    \"\"\"",
      "    Returns dictionary: id -> area (rounded to 2 decimals)",
      "    \"\"\"",
      "    result = {}",
      "",
      "    for sid, shape in shapes.items():",
      "        result[sid] = round(shape.area(), 2)",
      "",
      "    return result",
      "",
      "",
      "# ---------------------------------",
      "# 5. total_area",
      "# ---------------------------------",
      "def total_area(shapes):",
      "    \"\"\"",
      "    Returns sum of all areas (rounded to 2 decimals)",
      "    \"\"\"",
      "    total = 0.0",
      "    for shape in shapes.values():",
      "        total += shape.area()",
      "",
      "    return round(total, 2)",
      "",
      "",
      "# ---------------------------------",
      "# 6. largest_shape",
      "# ---------------------------------",
      "def largest_shape(shapes):",
      "    \"\"\"",
      "    Returns (id, area) of shape with largest area.",
      "    Empty dict -> (\"\", 0.0)",
      "    \"\"\"",
      "    if not shapes:",
      "        return (\"\", 0.0)",
      "",
      "    max_id = \"\"",
      "    max_area = 0.0",
      "",
      "    for sid, shape in shapes.items():",
      "        a = shape.area()",
      "        if a >= max_area:",
      "            max_area = a",
      "            max_id = sid",
      "",
      "    return (max_id, round(max_area, 2))",
      "",
      "",
      "# ---------------------------------",
      "# 7. scale_shape",
      "# ---------------------------------",
      "def scale_shape(shapes, factor: float):",
      "    \"\"\"",
      "    Multiplies all numeric dimensions by factor.",
      "    Modifies objects in-place.",
      "    \"\"\"",
      "",
      "    for shape in shapes.values():",
      "        if isinstance(shape, Circle):",
      "            shape.radius *= factor",
      "        elif isinstance(shape, Rectangle):",
      "            shape.width *= factor",
      "            shape.height *= factor",
      "",
      "",
      "# ---------------------------------",
      "# 8. describe_shape",
      "# ---------------------------------",
      "def describe_shape(shapes):",
      "    \"\"\"",
      "    Returns sorted list of description strings.",
      "    \"\"\"",
      "",
      "    desc = []",
      "",
      "    for sid, shape in shapes.items():",
      "        if isinstance(shape, Circle):",
      "            desc.append(",
      "                f\"Circle(id={sid}, radius={shape.radius:.2f}, area={shape.area():.2f})\"",
      "            )",
      "        elif isinstance(shape, Rectangle):",
      "            desc.append(",
      "                f\"Rectangle(id={sid}, width={shape.width:.2f}, height={shape.height:.2f}, area={shape.area():.2f})\"",
      "            )",
      "",
      "    return sorted(desc)",
      "",
      "",
      "# ---------------------------------",
      "# 9. filter_by_type",
      "# ---------------------------------",
      "def filter_by_type(shapes, typ):",
      "    \"\"\"",
      "    Returns dictionary containing only shapes of given type.",
      "    \"\"\"",
      "    return {",
      "        sid: shape",
      "        for sid, shape in shapes.items()",
      "        if isinstance(shape, typ)",
      "    }",
      "",
      "",
      "# ---------------------------------",
      "# SAMPLE INPUT (hard-coded)",
      "# ---------------------------------",
      "",
      "shapes = {",
      "    \"c1\": Circle(1),",
      "    \"r1\": Rectangle(2, 3)",
      "}",
      "",
      "# ---------------------------------",
      "# FUNCTION CALLS",
      "# ---------------------------------",
      "",
      "print(\"Areas:\")",
      "print(calc_areas(shapes))",
      "print()",
      "",
      "print(\"Total Area:\")",
      "print(total_area(shapes))",
      "print()",
      "",
      "print(\"Largest Shape:\")",
      "print(largest_shape(shapes))",
      "print()",
      "",
      "print(\"Scale shapes by factor 2:\")",
      "scale_shape(shapes, 2)",
      "print(describe_shape(shapes))",
      "print()",
      "",
      "print(\"Filter only Circles:\")",
      "print(filter_by_type(shapes, Circle))"
    ],
    "description": "Abstract Base Class with Shape, Circle, Rectangle and related operations"
  }
