      "# -------------------------------",
      "# Student-Grades Analytics",
      "# -------------------------------",
      "",
      "# 1. Average grades per student",
      "def average_grades(data):",
      "    result = {}",
      "",
      "    for student, subjects in data.items():",
      "        if subjects:",
      "            avg = sum(subjects.values()) / len(subjects)",
      "            result[student] = round(avg, 2)",
      "        else:",
      "            result[student] = 0.0",
      "",
      "    return result",
      "",
      "",
      "# 2. Max grade per student",
      "def max_grade_per_student(data):",
      "    result = {}",
      "",
      "    for student, subjects in data.items():",
      "        if subjects:",
      "            subject = max(subjects, key=subjects.get)",
      "            result[student] = (subject, float(subjects[subject]))",
      "        else:",
      "            result[student] = (\"\", 0.0)",
      "",
      "    return result",
      "",
      "",
      "# 3. Subject-wise average across students",
      "def subject_wise_average(data):",
      "    totals = {}",
      "    counts = {}",
      "",
      "    for subjects in data.values():",
      "        for subject, score in subjects.items():",
      "            totals[subject] = totals.get(subject, 0) + score",
      "            counts[subject] = counts.get(subject, 0) + 1",
      "",
      "    result = {}",
      "    for subject in totals:",
      "        result[subject] = round(totals[subject] / counts[subject], 2)",
      "",
      "    return result",
      "",
      "",
      "# 4. Flatten nested dictionary",
      "def flatten_nested(data):",
      "    result = []",
      "",
      "    for student, subjects in data.items():",
      "        for subject, score in subjects.items():",
      "            result.append((student, subject, float(score)))",
      "",
      "    return result",
      "",
      "",
      "# 5. Add or update student record (in-place)",
      "def add_student_record(data, sid, record):",
      "    data[sid] = {k: float(v) for k, v in record.items()}",
      "",
      "",
      "# -------------------------------",
      "# SAMPLE INPUT (hard-coded)",
      "# -------------------------------",
      "",
      "data = {",
      "    \"s1\": {\"math\": 80, \"eng\": 90},",
      "    \"s2\": {\"math\": 70}",
      "}",
      "",
      "# -------------------------------",
      "# FUNCTION CALLS",
      "# -------------------------------",
      "",
      "print(\"Average Grades:\")",
      "print(average_grades(data))",
      "print()",
      "",
      "print(\"Max Grade Per Student:\")",
      "print(max_grade_per_student(data))",
      "print()",
      "",
      "print(\"Subject-wise Average:\")",
      "print(subject_wise_average(data))",
      "print()",
      "",
      "print(\"Flatten Nested:\")",
      "print(flatten_nested(data))",
      "print()",
