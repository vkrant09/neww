      "        self.price = float(price)",
      "        self.qty = int(qty)",
      "",
      "",
      "# 2. update_inventory",
      "def update_inventory(inv, code, add_qty):",
      "    \"\"\"",
      "    Adjusts quantity of item with given code.",
      "    Ignores if code does not exist.",
      "    Returns total inventory value.",
      "    \"\"\"",
      "",
      "    if code in inv:",
      "        inv[code].qty += add_qty",
      "",
      "        # Quantity should not go below zero",
      "        if inv[code].qty < 0:",
      "            inv[code].qty = 0",
      "",
      "    total_value = 0.0",
      "    for item in inv.values():",
      "        total_value += item.price * item.qty",
      "",
      "    return total_value",
      "",
      "",
      "# 3. total_quantity",
      "def total_quantity(inv):",
      "    \"\"\"",
      "    Returns total quantity of all items.",
      "    \"\"\"",
      "",
      "    total = 0",
      "    for item in inv.values():",
      "        total += item.qty",
      "",
      "    return total",
      "",
      "",
      "# 4. most_valuable_item",
      "def most_valuable_item(inv):",
      "    \"\"\"",
      "    Returns (code, value) of item with highest price * qty.",
