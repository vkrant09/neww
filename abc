      "strings = [\"apple\", \"banana\", \"cherry\"]",
      "data = {\"a\": 10, \"b\": 5, \"c\": 20}",
      "",
      "# ---------------------------------",
      "# FUNCTION CALLS",
      "# ---------------------------------",
      "",
      "print(\"Square Even Numbers:\")",
      "print(square_even_numbers(nums))",
