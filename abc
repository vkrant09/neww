      "def char_freq(text):",
      "    # count frequency of each lowercase alphabetic character",
      "    return {",
      "        ch: text.lower().count(ch)",
      "        for ch in text.lower()",
      "        if ch.isalpha()",
      "    }",
      "",
      "def invert_dict(d):",
      "    # invert dict -> value becomes key, keys grouped in list",
      "    return {",
      "        v: [k for k in d if d[k] == v]",
      "        for v in d.values()",
      "    }",
      "",
      "def merge_dict(a, b):",
      "    # merge two dicts, sum values if key exists in both",
      "    return {",
      "        key: a.get(key, 0) + b.get(key, 0)",
      "        for key in set(a) | set(b)",
      "    }",
      "",
      "def filter_by_value(d, threshold):",
      "    # keep only items where value >= threshold",
      "    return {",
      "        k: v for k, v in d.items() if v >= threshold",
      "    }",
      "",
      "def sort_by_key(d):",
      "    # return dict items sorted by key",
      "    return sorted(d.items())",
      "",
      "text = \"Hello World!\"",
      "a = {\"x\": 1, \"y\": 2}",
      "b = {\"y\": 3, \"z\": 4}",
      "threshold = 2",
      "",
      "print(\"char_freq:\", char_freq(text))",
      "print(\"invert_dict:\", invert_dict(a | b))",
      "print(\"merge_dicts:\", merge_dict(a, b))",
      "print(\"filter_by_value:\", filter_by_value(merge_dict(a, b), threshold))",
      "print(\"sort_by_key:\", sort_by_key(merge_dict(a, b)))"
    ],
    "description": "Dictionary operations: frequency, invert, merge, filter, sort"
