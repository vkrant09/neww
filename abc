      "import os",
      "",
      "# ---------------------------------",
      "# 1. save_list",
      "# ---------------------------------",
      "def save_list(path, items):",
      "    \"\"\"",
      "    Overwrites file with items.",
      "    Each item is written on a new line.",
      "    Creates file if it does not exist.",
      "    \"\"\"",
      "    with open(path, \"w\", encoding=\"utf-8\") as f:",
      "        for item in items:",
      "            f.write(item + \"\\n\")",
      "",
      "# ---------------------------------",
      "# 2. load_list",
      "# ---------------------------------",
      "def load_list(path):",
      "    \"\"\"",
      "    Returns list of lines from file (newline stripped).",
      "    Returns empty list if file does not exist.",
      "    \"\"\"",
      "    if not os.path.exists(path):",
      "        return []",
      "",
      "    with open(path, \"r\", encoding=\"utf-8\") as f:",
      "        return [line.rstrip(\"\\n\") for line in f]",
      "",
      "# ---------------------------------",
      "# 3. append_to_list",
      "# ---------------------------------",
      "def append_to_list(path, items):",
      "    \"\"\"",
      "    Appends items to file.",
      "    Each item goes on a new line.",
      "    Creates file if it does not exist.",
      "    \"\"\"",
      "    with open(path, \"a\", encoding=\"utf-8\") as f:",
      "        for item in items:",
      "            f.write(item + \"\\n\")",
      "",
      "# ---------------------------------",
      "# 4. count_lines",
      "# ---------------------------------",
      "def count_lines(path):",
      "    \"\"\"",
      "    Returns number of lines in file.",
      "    Returns 0 if file does not exist.",
      "    \"\"\"",
      "    if not os.path.exists(path):",
      "        return 0",
      "",
      "    with open(path, \"r\", encoding=\"utf-8\") as f:",
      "        return sum(1 for _ in f)",
      "",
      "# ---------------------------------",
      "# 5. delete_file_if_empty",
      "# ---------------------------------",
      "def delete_file_if_empty(path):",
      "    \"\"\"",
      "    Deletes file if its size is zero bytes.",
      "    Returns True if deleted, False otherwise.",
      "    \"\"\"",
      "    if os.path.exists(path) and os.path.getsize(path) == 0:",
      "        os.remove(path)",
      "        return True",
      "",
      "    return False",
      "",
      "# ---------------------------------",
      "# SAMPLE INPUT (hard-coded)",
      "# ---------------------------------",
      "",
      "file_path = \"sample_list.txt\"",
      "items1 = [\"apple\", \"banana\", \"cherry\"]",
      "items2 = [\"date\", \"fig\"]",
      "",
      "# ---------------------------------",
      "# FUNCTION CALLS",
      "# ---------------------------------",
      "",
      "print(\"Saving list...\")",
      "save_list(file_path, items1)",
      "",
      "print(\"Loading list:\")",
      "print(load_list(file_path))",
      "print()",
      "",
      "print(\"Appending items...\")",
      "append_to_list(file_path, items2)",
      "",
      "print(\"Loading list after append:\")",
      "print(load_list(file_path))",
      "print()",
      "",
      "print(\"Counting lines:\")",
      "print(count_lines(file_path))",
      "print()",
      "",
      "print(\"Deleting file if empty:\")",
      "print(delete_file_if_empty(file_path))",
      "print()",
      "",
      "# Clear file content to test delete",
      "open(file_path, \"w\").close()",
      "",
      "print(\"Deleting file after clearing content:\")",
      "print(delete_file_if_empty(file_path))",
      "print(\"File exists?\", os.path.exists(file_path))"
